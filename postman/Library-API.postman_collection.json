    {
      "name": "TC06 - POST /books",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Trả về 201 Created\", () => {",
              "    pm.response.to.have.status(201);",
              "});",
              "const book = pm.response.json();",
              "pm.test(\"Có id và đúng ISBN\", () => {",
              "    pm.expect(book).to.have.property(\"id\");",
              "    pm.expect(book.isbn).to.eql(\"9786040000042\");",
              "});",
              "pm.collectionVariables.set(\"bookId\", book.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"isbn\": \"9786040000042\",\n    \"title\": \"Phát triển Web API với FastAPI\",\n    \"author\": \"Lê Minh Tuấn\",\n    \"year\": 2024,\n    \"quantity\": 4\n}"
